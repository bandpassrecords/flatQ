<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>flatQ</title>
    <organization>com.bandpassrecords</organization>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <options customize="always" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>
    <choice id="vst3" title="VST3 plug-in" description="Installs flatQ.vst3 to /Library/Audio/Plug-Ins/VST3 (Cubase, Reaper, Ableton Live, ...)">
        <pkg-ref id="com.bandpassrecords.flatq.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit plug-in" description="Installs flatQ.component to /Library/Audio/Plug-Ins/Components (Logic Pro, GarageBand, ...)">
        <pkg-ref id="com.bandpassrecords.flatq.au"/>
    </choice>
    <choice id="app" title="Standalone app" description="Installs flatQ.app to /Applications">
        <pkg-ref id="com.bandpassrecords.flatq.app"/>
    </choice>
    <pkg-ref id="com.bandpassrecords.flatq.vst3" version="@VERSION@" onConclusion="none">flatq-vst3.pkg</pkg-ref>
    <pkg-ref id="com.bandpassrecords.flatq.au" version="@VERSION@" onConclusion="none">flatq-au.pkg</pkg-ref>
    <pkg-ref id="com.bandpassrecords.flatq.app" version="@VERSION@" onConclusion="none">flatq-app.pkg</pkg-ref>
</installer-gui-script>
